<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Sample custom MCP tool for ArcGIS Enterprise 12.2: service-health-check.
    Generated from the MCP API Archetype, then extended with:
      - Apache HttpClient 5 (compile scope) to exercise third-party JAR loading on the server
      - a pinned Surefire version so JUnit 5 tests always run
      - ServicesResourceTransformer so META-INF/services files are merged when shading
      - relocation of the bundled HttpClient 5 and SLF4J packages, plus a no-op SLF4J binding,
        so they can't clash with copies of the same libraries on the server's class path
  -->

  <groupId>com.example.mcp</groupId>
  <artifactId>service-health-check</artifactId>
  <version>1.0.0</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mcp.shadedClassifier>deployment</mcp.shadedClassifier>
    <mcp.targetJRE>21</mcp.targetJRE>
    <arcgis-enterprise-version>12.2.0</arcgis-enterprise-version>
    <org.json.version>20231013</org.json.version>
    <httpclient5.version>5.4.1</httpclient5.version>
    <slf4j.version>1.7.36</slf4j.version>
    <junit-jupiter-engine-version>5.12.1</junit-jupiter-engine-version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
  </properties>

  <dependencies>
    <!-- Provided by ArcGIS Enterprise at run time; not packaged -->
    <dependency>
      <groupId>com.esri.arcgis.mcp.catalog</groupId>
      <artifactId>mcp-api</artifactId>
      <version>${arcgis-enterprise-version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>${org.json.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Third-party library packaged into the tool JAR (compile scope) -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <version>${httpclient5.version}</version>
    </dependency>
    <!--
      HttpClient 5 logs through SLF4J. Pin slf4j-api and bundle the matching no-op binding, so the
      (relocated) SLF4J inside the tool JAR finds its binding in the same JAR and never looks for
      one on the server's class path. Without this, SLF4J can pick up the server's binding and
      fail with "LinkageError: loader constraint violation" when the tool loads.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit-jupiter-engine-version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${mcp.targetJRE}</release>
        </configuration>
      </plugin>
      <!-- Pinned so JUnit 5 tests run on every Maven version -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>
      <!-- Generates config.json from SPI-registered IMCPTool implementations -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>generate-config-json</id>
            <phase>process-classes</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>com.esri.arcgis.mcp.catalog.mcp.api.build.ConfigJsonGenerator</mainClass>
              <classpathScope>compile</classpathScope>
              <arguments>
                <argument>${project.build.outputDirectory}/config.json</argument>
                <argument>${mcp.targetJRE}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
      <!-- Packages HttpClient 5 and its dependencies into the deployment JAR -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <shadedArtifactAttached>true</shadedArtifactAttached>
          <shadedClassifierName>${mcp.shadedClassifier}</shadedClassifierName>
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <filters>
            <filter>
              <artifact>*:*</artifact>
              <excludes>
                <exclude>**/ConfigJsonGenerator.class</exclude>
                <exclude>META-INF/*.SF</exclude>
                <exclude>META-INF/*.DSA</exclude>
                <exclude>META-INF/*.RSA</exclude>
              </excludes>
            </filter>
          </filters>
          <!--
            Rename bundled third-party packages so they can't clash with other copies on the
            server's class path. The server's tool class loader checks the tool JAR first and then
            its parents, so a library split across the two (for example SLF4J's API in the tool JAR
            and a binding on the server) fails at load time. Relocated packages exist only in the
            tool JAR.
          -->
          <relocations>
            <relocation>
              <pattern>org.apache.hc</pattern>
              <shadedPattern>com.example.mcp.healthcheck.shaded.hc</shadedPattern>
            </relocation>
            <relocation>
              <pattern>org.slf4j</pattern>
              <shadedPattern>com.example.mcp.healthcheck.shaded.slf4j</shadedPattern>
            </relocation>
          </relocations>
          <transformers>
            <!-- Merge META-INF/services files instead of keeping only the first one -->
            <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
          </transformers>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Packages the shaded JAR and config.json as a ZIP archive -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <configuration>
          <attach>false</attach>
          <descriptors>
            <descriptor>src/assembly/mcp.xml</descriptor>
          </descriptors>
        </configuration>
        <executions>
          <execution>
            <id>create-mcp-archive</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Gives the ZIP archive its deployable .mcp extension -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>rename-mcp-archive</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <move
                  file="${project.build.directory}/${project.build.finalName}-mcp.zip"
                  tofile="${project.build.directory}/${project.build.finalName}.mcp" />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
