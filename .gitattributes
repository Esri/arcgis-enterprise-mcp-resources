# Normalize line endings for text files
* text=auto

# Windows batch files must use CRLF; cmd.exe can mis-handle labels and GOTO with LF endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must use LF so they run on Linux/macOS
*.sh text eol=lf

# Binary artifacts
*.jar binary
*.zip binary
*.mcp binary
